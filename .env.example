# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Dog API Configuration
# Note: The Dog CEO API (https://dog.ceo/api/) is free and doesn't require an API key
# If you're using a different API that requires authentication, add it here:

# API_KEY=your_api_key_here
# API_BASE_URL=https://api.example.com

# Development Configuration
NODE_ENV=development
VITE_APP_TITLE=Dog Picker App

# Optional: If you want to use a different API endpoint
# VITE_DOG_API_URL=https://dog.ceo/api
